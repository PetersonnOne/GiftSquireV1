# GiftSquire local development configuration. Never commit this file.
# Provider credentials stay server-side; no backend/project linkage is inherited.

# OpenAI interpretation and live conversation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# YouCam REST API; key validated by a read-only authenticated request
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com
YOUCAM_API_KEY=
YOUCAM_SECRET_KEY=

# Demo narration and recorded-audio tooling
OPENROUTER_API_KEY=

# Existing verified email infrastructure; GiftSquire sender identity
RESEND_API_KEY=
RESEND_FROM="GiftSquire <accounts@notify.geneaone.com>"

# Destination Convex and Vercel settings will be added after separate GiftSquire projects exist.
